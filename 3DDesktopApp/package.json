{
  "name": "3d-scene-generator",
  "version": "1.0.0",
  "description": "AI驱动的3D场景生成器桌面应用",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "concurrently \"npm run dev-backend\" \"npm run dev-agent\" \"npm run dev-frontend\" \"npm run dev-electron\"",
    "dev-frontend": "cd frontend && npm run dev",
    "dev-backend": "cd backend && venv\\Scripts\\python.exe -m uvicorn main:app --host 127.0.0.1 --port 8000 --reload",
    "dev-agent": "cd backend/agent_service && node index.mjs",
    "dev-electron": "wait-on http://localhost:5173 && wait-on http://localhost:8000/docs && electron .",
    "build-frontend": "cd frontend && npm run build",
    "build-backend": "cd backend && venv\\Scripts\\pip.exe install -r requirements.txt",
    "build-agent": "cd backend/agent_service && npm install",
    "install-all": "npm install && npm run build-frontend && npm run build-agent && npm run build-backend",
    "pack": "npm run build-frontend && electron-builder --dir",
    "dist": "npm run build-frontend && electron-builder",
    "dist-win": "npm run build-frontend && electron-builder --win --x64"
  },
  "build": {
    "extends": null
  },
  "keywords": ["3d", "ai", "scene-generator", "electron"],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^8.2.2",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "wait-on": "^7.2.0"
  }
}
